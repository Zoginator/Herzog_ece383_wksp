/************************** Constant Definitions ****************************/
/*
 * The following constants define the slave registers used for our Counter PCORE
 */
#define countBase		0x44a00000
#define NES_buttons		countBase			//8 LSBs of slv_reg0 are NES_buttons
#define	mouse_pos	countBase+4			// 16 LSBs of slv_reg1 are Mouse coordinates (15-8 is y, 7-0 is x)
#define	level_sel	countBase+8			// 4 LSB of slvReg 2
#define ball_pos	countBase+0xc	// using bottom 16 bits of slv reg 3
//#define show_win	countBase+0x10	// using bottom bit of slv reg 4 (this was incorrectly assigned to slv 7 in hardware #fix
#define frame_flag	countBase+0x14	// using the LSB of slv reg 5
#define clear_flag 	countBase+0x18	// using the LSB of slv reg 6
#define show_win	countBase+0x1c	// using the bottom 11 bits slv reg 7 #fix later, this should be 4

//NES controller buttons
#define LEFT	0
#define RIGHT	1
#define DOWN	2
#define UP		3
#define START	4
#define SELECT	5
#define B_B		6
#define B_A		7

#define WALL	2

//current highest level
#define LEVEL_MAX 1

/************************** FSM States ****************************/
typedef enum {
    STATE_TITLE,
    STATE_WAIT_SHOT,
	STATE_LOAD_LEVEL,
    STATE_LEVEL_NEXT,
	STATE_LEVEL_PREV,
	STATE_MOVE_BALL,
	STATE_CHECK_WALL,
	STATE_CHECK_HOLE,
	STATE_FRICTION,
	STATE_CHECK_BALL_VEL,
	STATE_WAIT_ANIM,
	STATE_WIN
} FSMstate;


/************************** Function Prototypes ****************************/
/**
 * @brief retrieves the NES button bits from slave registers
 * @param a boolean array to store each button
 */
void get_NES(bool* active_buttons);

/**
 * @brief retrieves mouse x and y coordinates from slave registers
 * and converts them into integers
 * @param a boolean array to store each button
 */
int get_mouse_x();
int get_mouse_y();

/**
 * @brief send ball x and y coordinates to slave register
 * and converts them into integers
 * @param ball_x
 * @param ball_y
 */
void update_ball(int ball_x, int ball_y);

/**
 * @brief updates current level of the game
 * @param level - which level to switch to
 */
void update_level(int level);

/**
 * @brief updates win state of the game
 * @param win - boolean to show win
 */
void update_win(bool win);

/**
 * @brief calculate ball velocity when ball is hit
 * @param mouse and ball coords
 * @return integer with velocity value
 */
float velocity_vector_ball(int ball_vec, int mouse_x);

/**
 * @brief floors negative values, ceilings positive values
 */
int absoluteCeil(float val);

#endif
