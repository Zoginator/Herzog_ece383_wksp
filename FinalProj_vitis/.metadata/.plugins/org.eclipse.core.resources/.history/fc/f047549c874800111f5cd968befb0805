/************************** Constant Definitions ****************************/
#define printf xil_printf			/* A smaller footprint printf */
#define	uartRegAddr			0x40600000		// read <= RX, write => TX

/*
 * The following constants define the slave registers used for our Counter PCORE
 */
#define countBase		0x44a00000
#define NES_buttons		countBase			//8 LSBs of slv_reg0 are NES_buttons
#define	mouse_pos	countBase+4			// 16 LSBs of slv_reg1 are Mouse coordinates (15-8 is y, 7-0 is x)
#define	level_sel	countBase+8			// 4 LSB of slvReg 2
#define ball_pos	countBase+0xc	// using bottom 16 bits of slv reg 3
#define show_win	countBase+0x10	// using bottom bit of slv reg 4
#define frame_flag	countBase+0x14	// using the LSB of slv reg 5
#define clear_flag 	countBase+0x18	// using the LSB of slv reg 6
//#define score_hits	countBase+0x1c	// using the bottom 11 bits slv reg 7 (unused)


