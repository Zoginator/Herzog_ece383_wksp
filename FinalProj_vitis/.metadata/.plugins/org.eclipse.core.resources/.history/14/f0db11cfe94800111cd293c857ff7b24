#include "game_functions.h"


void get_NES(bool* active_buttons){
	uint8_t buttons = Xil_In8(NES_buttons);

	active_buttons[LEFT] 	= (buttons & 0b00000001) != 0; // Left
	active_buttons[RIGHT] 	= (buttons & 0b00000010) != 0; // Right
	active_buttons[DOWN] 	= (buttons & 0b00000100) != 0; // Down
	active_buttons[UP] 		= (buttons & 0b00001000) != 0; // Up
	active_buttons[START] 	= (buttons & 0b00010000) != 0; // Start
	active_buttons[SELECT]	= (buttons & 0b00100000) != 0; // Select
	active_buttons[B_B] 	= (buttons & 0b01000000) != 0; // B
	active_buttons[B_A] 	= (buttons & 0b10000000) != 0; // A
}


int get_mouse_x(){
	return Xil_In16(mouse_pos) & 0x00FF;
}

int get_mouse_y(){
	return (Xil_In16(mouse_pos) >> 8) & 0xFF;
}

void update_ball(int ball_x, int ball_y){
	unsigned u_ball_x, u_ball_y;

	if (ball_x < 0){u_ball_x = 0;}
		else if (ball_x > 119){u_ball_x = 119;}
		else{u_ball_x = ball_x;}

	if (ball_y < 0){u_ball_y = 0;}
		else if (ball_y > 119){u_ball_y = 119;}
		else{u_ball_y = ball_y;}

	unsigned combined = (u_ball_y << 8) | u_ball_x;
	Xil_Out16(ball_pos, combined);

}

void update_level(int level){
	unsigned u_level;

	if (level < 0){u_level = 0;}
			else if (level > 1){u_level = 1;} //only 1 level currently
			else{u_level = level;}

	unsigned masked_level = (u_level && 0xF); //mask to ensure only 4 bits are passed
	Xil_Out16(level_sel, masked_level);
}

void update_win(bool win){
	if (win){Xil_Out8(show_win, 0x01);}
	else {Xil_Out8(show_win, 0x00);}
}

float velocity_vector_ball(int ball_vec, int mouse_vec){
	float vel = 0;
	float diff;
	diff = (ball_vec - mouse_vec) / 1.5;

	if (diff == 0){
		vel = 0;
	}
	else if (diff > 8.0){
		vel = 8.0;
	}
	else if (diff < -8.0){
		vel = -8.0;
	}
	else{
		vel = diff;
	}

	return vel;
}

int absoluteCeil(float val){
	if (fabsf(val) < 0.3){
		return 0;
	}
	else if (val < 0){
		return (int)floor(val);
	}
	else{
		return (int)ceil(val);
	}
}

float check_collsion_x(int ball_x, int ball_y, float vel_x, int level){
	int position = 120*ball_y + ball_x;

	if (vel_x == 0){
		return vel_x;
	}
	else if (vel_x < 0){
		if (levels[level-1][position-1] = WALL){
			vel_x = vel_x * -1.0;
		}
	}
	else{
		if (levels[level-1][position+1] = WALL){
			vel_x = vel_x * -1.0;
		}
	}

	return vel_x;
}

float check_collsion_y(int ball_x, int ball_y, float vel_y, int level){
	int position = 120*ball_y + ball_x;

	if (vel_y == 0){
		return vel_y;
	}
	else if (vel_y < 0){
		if (levels[level-1][position-120] == WALL){
			vel_y = vel_y * -1.0;
		}
	}
	else{
		if (levels[level-1][position+120] == WALL){
			vel_y = vel_y * -1.0;
		}
	}

	return vel_y;
}


