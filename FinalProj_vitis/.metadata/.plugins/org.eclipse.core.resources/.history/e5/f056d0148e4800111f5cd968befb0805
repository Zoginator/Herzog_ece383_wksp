#include "game_functions.h"


void get_NES(bool* active_buttons){
	uint8_t buttons = Xil_In8(NES_buttons);

	active_buttons[0] = (buttons & 0b00000001) != 0; // Left
	active_buttons[1] = (buttons & 0b00000010) != 0; // Right
	active_buttons[2] = (buttons & 0b00000100) != 0; // Down
	active_buttons[3] = (buttons & 0b00001000) != 0; // Up
	active_buttons[4] = (buttons & 0b00010000) != 0; // Start
	active_buttons[5] = (buttons & 0b00100000) != 0; // Select
	active_buttons[6] = (buttons & 0b01000000) != 0; // B
	active_buttons[7] = (buttons & 0b10000000) != 0; // A
}


int get_mouse_x(){
	return Xil_in16(mouse_pos) & 0x00FF;
}

int get_mouse_y(){
	return (Xil_in16(mouse_pos) >> 8) & 0xFF;
}
