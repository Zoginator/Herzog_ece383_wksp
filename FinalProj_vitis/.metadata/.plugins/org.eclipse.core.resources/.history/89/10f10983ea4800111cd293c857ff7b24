/*
 * game_main.c: main logic and loop for ZoGolf
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include "xparameters.h"
#include "stdio.h"
#include "stdlib.h"
#include "math.h"
#include "xstatus.h"
#include "stdbool.h"

#include "platform.h"
#include "xil_printf.h"
#include <xuartlite_l.h>					// Contains XUartLite_RecvByte
#include <xil_io.h>							// Contains Xil_Out8 and its variations

#include "game_functions.h"

static int frame_count = 0;
#define FRICTION 0.2;


/************************** Function Prototypes ****************************/
void myISR(void);


int main(void){
	/************************** Variable Declarations ****************************/

	bool NES[8] = {false, false, false, false,
				   false, false, false, false};

	bool showWin = false;
	int mouse_x;
	int mouse_y;
	int ball_x = 119;
	int ball_y = 119;
	float vel_x = 0;
	float vel_y = 0;
	float t_vel_x = 0;
	float t_vel_y = 0;
	//int friction_count = 0; //keeps track of which turns to apply friction (unused)
	int current_level = 0;
	FSMstate currentState = STATE_TITLE;
	FSMstate nextState = STATE_TITLE;

	/************************** END Variable Declarations ****************************/
	init_platform();

	print("Welcome to ZoGolf_V1\n\r");

    microblaze_register_handler((XInterruptHandler) myISR, (void *) 0);
    microblaze_enable_interrupts();

    Xil_Out8(clear_flag, 0x01);					// Clear the flag and then you MUST
	Xil_Out8(clear_flag, 0x00);					// allow the flag to be reset later

	//update_level(current_level);	//set level to 0
	//update_ball(ball_x, ball_y);	//initial mouse setup

	/************************** Main Game Loop ****************************/
	while(1){

		//load inputs
		get_NES(NES);
		mouse_x = get_mouse_x();
		mouse_y = get_mouse_y();

		if(NES[SELECT]){
			currentState = STATE_TITLE;
			nextState = STATE_TITLE;
		}


	    switch (currentState) {
	        case STATE_TITLE:
	            current_level = 0;
	            ball_x = 25;
	            ball_y = 100;
	            showWin = false;
	            if(NES[START]){
	            	nextState = STATE_LEVEL_NEXT;
	            }
	            else{
					nextState = STATE_TITLE;
				}
	            break;

	        case STATE_LEVEL_NEXT:
	        	if (current_level < LEVEL_MAX){
	        		current_level += 1;
	        	}
	        	nextState = STATE_LOAD_LEVEL;
	            break;

	        case STATE_LEVEL_PREV:
	        	if (current_level > 1){
					current_level -= 1;
				}
				nextState = STATE_LOAD_LEVEL;
	            break;

	        case STATE_LOAD_LEVEL:
	        	// get initial ball value
	        	// array? make title screen playable?
	        	nextState = STATE_WAIT_SHOT;
	        	break;

	        case STATE_WAIT_SHOT:
	        	if(NES[LEFT]){
	        		nextState = STATE_LEVEL_PREV;
	        	}
	        	else if(NES[RIGHT]){
	        		nextState = STATE_LEVEL_NEXT;
	        	}
	        	else if(NES[B_A]){
	        		while(NES[B_A]){get_NES(NES);}; //wait until button release
	        		frame_count = 0;

	        		vel_x = velocity_vector_ball(ball_x, mouse_x);
	        		vel_y = velocity_vector_ball(ball_y, mouse_y);
	        		nextState = STATE_MOVE_BALL;
	        	}
	        	else{
	        		nextState = STATE_WAIT_SHOT;
	        	}
	        	break;

	        case STATE_MOVE_BALL:
	        	t_vel_x = abs(absoluteCeil(vel_x));
	        	t_vel_y = abs(absoluteCeil(vel_y));

	        	while(t_vel_x > 0){
	        		vel_x = check_collision_x(ball_x, ball_y, vel_x, current_level);

	        		if(vel_x < 0)		{ball_x -= 1;}
	        		else if(vel_x > 0)	{ball_x += 1;}
	        		t_vel_x--;
	        	}

	        	while(t_vel_y > 0){
					vel_y = check_collision_y(ball_x, ball_y, vel_y, current_level);

					if(vel_y < 0)		{ball_y -= 1;}
					else if(vel_y > 0)	{ball_y += 1;}
					t_vel_y--;
				}

				nextState = STATE_CHECK_WALL;
	            break;

	        case STATE_CHECK_WALL:
	        	//this state needs to be handled in move ball
	        	nextState = STATE_CHECK_HOLE;
	            break;

	        case STATE_CHECK_HOLE:
	        	//if ball coords = hole coords, next state is win and vels = 0
	        	nextState = STATE_FRICTION;
	        	break;

	        case STATE_FRICTION:

				if 		(fabsf(vel_x) <= 0.2){vel_x = 0;}
				else if (vel_x < 0)	{vel_x += FRICTION;}
				else 				{vel_x -= FRICTION;}

				if 		(fabsf(vel_y) <= 0.2){vel_y = 0;}
				else if (vel_y < 0)	{vel_y += FRICTION;}
				else 				{vel_y -= FRICTION;}

				friction_count = 0;

	        	nextState = STATE_CHECK_BALL_VEL;
	        	break;

	        case STATE_CHECK_BALL_VEL:
	        	 if (vel_x == 0 && vel_y == 0){
	        		 nextState = STATE_WAIT_SHOT;
	        	 }
	        	 else{
	        		 nextState = STATE_WAIT_ANIM;
	        	 }
	        	 break;

	        case STATE_WAIT_ANIM:
	        	if (frame_count > 4){
	        		frame_count = 0;
	        		nextState = STATE_MOVE_BALL;
	        	}
	        	else{
	        		nextState = STATE_WAIT_ANIM;
	        	}

				break;

			case STATE_WIN:

				break;

	        default:
	        	break;
	    }

	    currentState = nextState;

	    //update outputs
	    update_ball(ball_x, ball_y);
	    update_win(showWin);
	    update_level(current_level);



	} // end main game loop
    return 0;
} //end main

void myISR(void) {
	frame_count = frame_count + 1;
	if (frame_count > 100){frame_count = 0;}

	Xil_Out8(clear_flag, 0x01);					// Clear the flag and then you MUST
	Xil_Out8(clear_flag, 0x00);					// allow the flag to be reset later
}
